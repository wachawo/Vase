#!/bin/bash
# Post-commit hook: Generate MD5 hashes for modified/added/deleted files only
#
# SETUP ON NEW SYSTEM:
# Run once after cloning: git config core.hooksPath .github/hooks

# Ensure .md5 directory exists
mkdir -p ".md5"

# Get files changed in the last commit (excluding .md5/ directory)
git diff --name-only HEAD~1 HEAD | grep -v "^\.md5/" | while read -r file; do
    # Hash the file path - used as the .md5 filename
    path_hash=$(printf '%s' "$file" | md5sum | awk '{print $1}')

    if [ -f "$file" ]; then
        # File exists - update its hash (per-line format: line_number:hash)
        : > ".md5/$path_hash.md5"  # Clear/create the file
        # Line 0: hash of the file path (for reverse lookup)
        echo "0:$path_hash" >> ".md5/$path_hash.md5"
        # Lines 1+: hash of each line's content
        line_num=0
        while IFS= read -r line || [ -n "$line" ]; do
            line_num=$((line_num + 1))
            hash=$(printf '%s' "$line" | md5sum | awk '{print $1}')
            echo "$line_num:$hash" >> ".md5/$path_hash.md5"
        done < "$file"
    else
        # File was deleted - remove its hash file
        rm -f ".md5/$path_hash.md5"
    fi
done

# Check if there are changes in .md5/
if [ -n "$(git status --porcelain .md5/)" ]; then
    # Stage and commit the .md5 changes
    git add .md5/
    git commit --no-verify -m "$(date +%H:%M) MD5 Sums"
fi
