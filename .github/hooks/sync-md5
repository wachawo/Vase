#!/usr/bin/env python3
"""
Sync MD5 hashes for all tracked files in the repository

SETUP: This script is meant to be run manually when you need to regenerate
all MD5 checksums (e.g., after forgetting to commit them or fixing issues)

Usage: ./.github/hooks/sync-md5

This script:
- Generates MD5 checksums for ALL files tracked by git
- Excludes the .md5/ directory itself (same as post-commit hook)
- Stores them in .md5/ directory as <path_hash>.md5 files (flat structure)
- Stages changes but does NOT auto-commit (you review first)
"""

import hashlib
import os
import shutil
import subprocess

def md5(s):
    return hashlib.md5(s.encode()).hexdigest()

def hash_path(filepath):
    """Hash each component of the path individually."""
    parts = filepath.split(os.sep)
    hashed_parts = [md5(part) for part in parts]
    return os.path.join(*hashed_parts)

def process_file(filepath):
    path_hash = md5(filepath)
    hashed_path = hash_path(filepath)
    output_dir = os.path.join('.md5', os.path.dirname(hashed_path))
    output_file = os.path.join('.md5', hashed_path)

    os.makedirs(output_dir, exist_ok=True)

    output = [f"0:{path_hash}"]

    with open(filepath, 'r', errors='replace') as f:
        for i, line in enumerate(f, 1):
            line_hash = md5(line.rstrip('\n'))
            output.append(f"{i}:{line_hash}")

    with open(output_file, 'w') as f:
        f.write('\n'.join(output) + '\n')

def main():
    print("[+] Starting MD5 sync for all tracked files...")
    print()

    # Get tracked files from git
    result = subprocess.run(['git', 'ls-files'], capture_output=True, text=True)
    files = [f for f in result.stdout.strip().split('\n') if f and not f.startswith('.md5/')]

    # Ensure .md5 directory exists and clean old files
    print("[+] Cleaning old .md5 directory...")
    if os.path.exists('.md5'):
        shutil.rmtree('.md5')
    os.makedirs('.md5')

    # Process files
    count = 0
    for filepath in files:
        if os.path.isfile(filepath):
            process_file(filepath)
            count += 1
            if count % 50 == 0:
                print(f"  Progress: {count}/{len(files)} files processed...")

    print()
    print("[+] MD5 sync complete!")
    print(f"[+] Processed {count} files")
    print()
    print("[+] Changes are staged. Review with:")
    print("    git status")
    print("    git diff --cached .md5/")
    print()
    print("[+] If everything looks good, commit with:")
    print("    git add .md5/")
    print("    git commit -m 'Sync all MD5 checksums'")

if __name__ == '__main__':
    main()
